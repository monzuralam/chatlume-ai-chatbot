{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "chatlume/chat",
	"title": "Chatlume Chat",
	"category": "widgets",
	"icon": "format-chat",
	"description": "Embed the Chatlume chat in this page. The floating chat button is hidden on pages with an embedded chat.",
	"keywords": [ "chat", "chatbot", "assistant", "support" ],
	"textdomain": "chatlume-ai-chatbot",
	"attributes": {
		"height": {
			"type": "number",
			"default": 600
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": {
			"margin": true
		}
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
