{
	"name": "chatlume/chatlume-ai-chatbot",
	"description": "Multi-provider AI chatbot for WordPress.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.0",
		"smalot/pdfparser": "^2.11"
	},
	"require-dev": {
		"brain/monkey": "^2.6",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"mockery/mockery": "^1.6",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpunit/phpunit": "^9.6",
		"wp-coding-standards/wpcs": "^3.1",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"autoload": {
		"psr-4": {
			"Chatlume\\": "includes/"
		},
		"classmap": [
			"vendor-prefixed/"
		]
	},
	"autoload-dev": {
		"psr-4": {
			"Chatlume\\Tests\\": "tests/php/"
		}
	},
	"config": {
		"platform": {
			"php": "8.0.30"
		},
		"optimize-autoloader": true,
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"extra": {
		"strauss": {
			"target_directory": "vendor-prefixed",
			"namespace_prefix": "Chatlume\\Vendor\\",
			"classmap_prefix": "Chatlume_Vendor_",
			"constant_prefix": "CHATLUME_VENDOR_",
			"delete_vendor_packages": true
		}
	},
	"scripts": {
		"prefix-namespaces": [
			"@php -r \"file_exists('vendor/strauss.phar') || copy('https://github.com/BrianHenryIE/strauss/releases/download/0.27.4/strauss.phar', 'vendor/strauss.phar') || exit(1);\"",
			"@php vendor/strauss.phar",
			"@composer dump-autoload"
		],
		"post-install-cmd": [
			"@prefix-namespaces"
		],
		"post-update-cmd": [
			"@prefix-namespaces"
		],
		"test": "@php vendor/bin/phpunit",
		"phpcs": "@php vendor/bin/phpcs",
		"phpcbf": "@php vendor/bin/phpcbf"
	},
	"version": "0.1.0"
}
