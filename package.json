{
	"name": "chatlume-ai-chatbot",
	"version": "0.1.0",
	"private": true,
	"description": "Multi-provider AI chatbot for WordPress.",
	"license": "GPL-2.0-or-later",
	"engines": {
		"node": ">=22.22.2"
	},
	"files": [
		"chatlume-ai-chatbot.php",
		"uninstall.php",
		"readme.txt",
		"includes",
		"build",
		"vendor/autoload.php",
		"vendor/composer",
		"vendor-prefixed",
		"languages",
		"src",
		"webpack.config.js",
		"postcss.config.js",
		"tsconfig.json",
		"package.json",
		"composer.json"
	],
	"scripts": {
		"start": "wp-scripts start --hot",
		"start:no-hot": "wp-scripts start",
		"build": "wp-scripts build",
		"lint": "npm run lint:js && npm run lint:style && npm run lint:types",
		"lint:js": "wp-scripts lint-js src tests/js webpack.config.js postcss.config.js jest.config.js eslint.config.js",
		"lint:style": "wp-scripts lint-style \"src/**/*.css\"",
		"lint:types": "tsc --noEmit",
		"lint:php": "composer run phpcs",
		"format": "wp-scripts format src tests/js",
		"test": "wp-scripts test-unit-jest",
		"i18n": "wp i18n make-pot . languages/chatlume-ai-chatbot.pot --exclude=node_modules,vendor,vendor-prefixed,tests,docs,src && wp i18n make-json languages --use-map=build/admin/map.json --no-purge",
		"zip": "composer install --no-dev --optimize-autoloader && wp-scripts plugin-zip && composer install"
	},
	"dependencies": {
		"@hookform/resolvers": "^5.9.1",
		"@radix-ui/react-alert-dialog": "^1.2.1",
		"@radix-ui/react-slot": "^1.5.0",
		"@radix-ui/react-switch": "^1.4.1",
		"@radix-ui/react-tooltip": "^1.4.1",
		"@tanstack/react-query": "^5.104.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.57.0",
		"motion": "^14.2.0",
		"react-hook-form": "^7.90.0",
		"react-router": "^7.18.4",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.7.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/jest": "^30.0.0",
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"@wordpress/api-fetch": "^7.57.0",
		"@wordpress/babel-preset-default": "^8.55.0",
		"@wordpress/dom-ready": "^4.57.0",
		"@wordpress/element": "^6.46.0",
		"@wordpress/eslint-plugin": "^27.1.0",
		"@wordpress/i18n": "^6.30.0",
		"@wordpress/jest-preset-default": "^14.2.0",
		"@wordpress/postcss-plugins-preset": "^5.57.0",
		"@wordpress/scripts": "^36.1.0",
		"babel-jest": "^30.5.0",
		"cssnano": "^6.1.2",
		"eslint-plugin-jest": "^29.17.0",
		"jest": "^30.5.0",
		"jest-environment-jsdom": "^30.5.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3"
	}
}
